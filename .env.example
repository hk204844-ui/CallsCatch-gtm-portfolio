# Copy to .env locally — never commit .env
# Configure the same keys as credentials inside n8n Cloud

# Google
GOOGLE_PLACES_API_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GMAIL_OAUTH_CLIENT_ID=
