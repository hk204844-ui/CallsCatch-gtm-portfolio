# Optional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
META_GRAPH_ACCESS_TOKEN=

# Safety
TEST_MODE=true
N8N_WEBHOOK_BASE_URL=
